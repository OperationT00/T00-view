# Copy to .env. Replace every placeholder before the first compose startup.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_USERNAME=admin
# At least 12 characters; BCrypt accepts at most 72 UTF-8 bytes.
BOOTSTRAP_PASSWORD=
# false only for localhost HTTP; use true when accessing through HTTPS.
COOKIE_SECURE=false
# Enable the independent public sharing module after configuring its encryption key.
PIKPAK_ENABLED=false
# Base64-encoded random 32-byte key; preserve it to decrypt saved share passcodes.
PIKPAK_SECRET_KEY=
# Optional HTTP CONNECT proxy reachable from the app/container, e.g. http://proxy:7897
PIKPAK_PROXY_URL=
